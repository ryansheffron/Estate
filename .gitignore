# Estate Standard - Git Ignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (IMPORTANT: Never commit secrets!)
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backend specific
backend/node_modules/
backend/dist/
backend/.env
backend/.env.local
backend/prisma/*.db
backend/prisma/*.db-journal

# Mobile specific
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/*.orig.*
mobile/web-build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Secrets and credentials (CRITICAL)
*.pem
*.key
*.cert
credentials.json
serviceAccount.json
