# Estate Standard - Environment Variables
# SECURITY NOTE: Never commit this file with real values!
# Copy to .env and fill in actual values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/estate_standard?schema=public"

# ============================================================================
# SERVER
# ============================================================================
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# Trust proxy (set to 1 if behind reverse proxy like nginx)
TRUST_PROXY=1

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
JWT_SECRET="your-secret-key-change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-this-in-production-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ============================================================================
# ENCRYPTION (CRITICAL - Generate with: openssl rand -hex 32)
# ============================================================================
ENCRYPTION_KEY="your-256-bit-encryption-key-hex-64-chars-change-in-production"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# ============================================================================
# PASSWORD POLICY
# ============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90

# ============================================================================
# ACCOUNT SECURITY
# ============================================================================
# Account lockout after failed login attempts
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_REQUIRED=true

# Password reset
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=3

# Session settings
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE="strict"

# ============================================================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ============================================================================
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="Estate Standard"
TWO_FACTOR_BACKUP_CODES_COUNT=10
TWO_FACTOR_WINDOW=2

# ============================================================================
# STRIPE (Payment Processing)
# ============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_FEE_PERCENT=15

# ============================================================================
# TWILIO (SMS Notifications)
# ============================================================================
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1..."

# ============================================================================
# SENDGRID (Email Service)
# ============================================================================
SENDGRID_API_KEY="SG..."
SENDGRID_FROM_EMAIL="concierge@estatestandard.com"
SENDGRID_FROM_NAME="Estate Standard"
SENDGRID_REPLY_TO_EMAIL="support@estatestandard.com"

# Email templates
EMAIL_VERIFICATION_TEMPLATE_ID="d-..."
PASSWORD_RESET_TEMPLATE_ID="d-..."
WELCOME_EMAIL_TEMPLATE_ID="d-..."

# ============================================================================
# AWS S3 (File Storage)
# ============================================================================
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="estate-standard-uploads"
AWS_S3_ENCRYPTION="AES256"

# File upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# ============================================================================
# AI / OPENAI (V1+)
# ============================================================================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4"
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ============================================================================
# RATE LIMITING
# ============================================================================
# Global API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Password reset
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3

# Email verification
EMAIL_VERIFY_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFY_RATE_LIMIT_MAX_REQUESTS=3

# File uploads
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20

# Payments
PAYMENT_RATE_LIMIT_WINDOW_MS=300000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=3

# Messaging
MESSAGE_RATE_LIMIT_WINDOW_MS=3600000
MESSAGE_RATE_LIMIT_MAX_REQUESTS=10

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================================================
# SECURITY HEADERS
# ============================================================================
HELMET_CSP_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL="info"
LOG_DIR="logs"
LOG_MAX_SIZE="20m"
LOG_MAX_FILES="14d"
LOG_DATE_PATTERN="YYYY-MM-DD"

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# ============================================================================
# CSRF PROTECTION
# ============================================================================
CSRF_ENABLED=false
CSRF_COOKIE_NAME="_csrf"
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTP_ONLY=true

# ============================================================================
# REQUEST TIMEOUT
# ============================================================================
REQUEST_TIMEOUT_MS=30000

# ============================================================================
# WEBHOOK SECURITY
# ============================================================================
WEBHOOK_SECRET="your-webhook-secret-change-in-production"
WEBHOOK_TOLERANCE_SECONDS=300
